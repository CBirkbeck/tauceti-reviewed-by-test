[Unit]
Description=Tau Ceti review answerer: the open noes and questions on the review site answered, and people's reviews settled in Tau Ceti pull requests
Documentation=https://github.com/CBirkbeck/tauceti-reviewed-by-test/blob/main/docs/superpowers/specs/2026-11-07-review-fixer-design.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/tauceti-answerer/review
Environment=PATH=%h/tauceti-answerer/venv/bin:%h/.elan/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8
Environment=PYTHONUNBUFFERED=1
# One system, every twelve hours (asked 2026-11-07): answer the open noes and questions; see the fixer's pull
# requests through Tau Ceti's review; then settle people's new reviews in pull requests. A stage that fails does not
# stop the next ("-").
ExecStart=-%h/tauceti-answerer/venv/bin/python -m answerer run
ExecStart=-%h/tauceti-answerer/venv/bin/python -m fixer follow
ExecStart=%h/tauceti-answerer/venv/bin/python -m fixer run
TimeoutStartSec=11h
Nice=10
MemoryMax=32G
