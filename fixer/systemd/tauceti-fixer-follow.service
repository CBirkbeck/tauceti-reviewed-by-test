[Unit]
Description=Tau Ceti review fixer: its pull requests seen through Tau Ceti's review (conflicts, CI, findings, comments)
Documentation=https://github.com/CBirkbeck/tauceti-reviewed-by-test/blob/main/docs/superpowers/specs/2026-11-07-review-fixer-design.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/tauceti-fixer/review
Environment=PATH=%h/tauceti-answerer/venv/bin:%h/.elan/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/git -C %h/tauceti-fixer/review pull -q --ff-only
ExecStart=%h/tauceti-answerer/venv/bin/python -m fixer follow
TimeoutStartSec=6h
Nice=10
MemoryMax=32G
